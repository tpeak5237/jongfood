APP_URL=http://localhost:4173
DEFAULT_LOCALE=th-TH
DEFAULT_TIME_ZONE=Asia/Bangkok
DEFAULT_CURRENCY=THB
# Production requires PostgreSQL. Local browser tests may omit this and use the
# explicit in-memory demo adapter; it is never allowed when NODE_ENV=production.
DATABASE_URL=
JONGFOOD_STORE=memory
JONGFOOD_AUTO_MIGRATE=false
JONGFOOD_SEED_DEMO=true
